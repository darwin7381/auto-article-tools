DATABASE_URL=sqlite:///./data/app.db
MAX_CONCURRENT_JOBS=20
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000

# LLM / 影像
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# 物件儲存（R2，選用；沒設就用本地 data/ + /files 代理）
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blocktempo-ai
R2_PUBLIC_BASE=

# WordPress 發布（對外動作；預設建草稿）
WORDPRESS_API_URL=
WORDPRESS_API_USER=
WORDPRESS_API_PASSWORD=


# URL 進稿 fallback（Firecrawl，選用）
FIRECRAWL_API_KEY=

# Google Sheets 整合(BD/DM 財務真相帳本)
# Service Account:bd-platform@miniai-crab-labs.iam.gserviceaccount.com(GCP 專案 miniai-crab-labs)
# 四份 Sheet(BD 2025/2026、DM 2025/2026)須共用給上述 SA;schema 見 docs/SHEETS-SCHEMA.md
GOOGLE_SERVICE_ACCOUNT_JSON=.secrets/google-sa.json
