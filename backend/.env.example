DATABASE_URL=sqlite:///./data/app.db
MAX_CONCURRENT_JOBS=20
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8000

# LLM / 影像
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# 物件儲存（R2，選用；沒設就用本地 data/ + /files 代理）
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blocktempo-ai
R2_PUBLIC_BASE=

# WordPress 發布（對外動作；預設建草稿）
WORDPRESS_API_URL=
WORDPRESS_API_USER=
WORDPRESS_API_PASSWORD=

# Strapi（設定遷移來源；遷移完成後可不再依賴）
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# URL 進稿 fallback（Firecrawl，選用）
FIRECRAWL_API_KEY=
